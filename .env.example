# wukong — environment template
# Copy to .env and fill in. The runtime reads these from the process
# environment; it never writes credentials to disk.
#
#   set -a && source .env && set +a
#
# Then select one with:  wukong config set default_model deepseek

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Optional: point at a gateway (OpenRouter, LiteLLM, one-api, vLLM...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- DeepSeek -------------------------------------------------------------
DEEPSEEK_API_KEY=

# --- 通义千问 / DashScope -------------------------------------------------
DASHSCOPE_API_KEY=

# --- Local models ---------------------------------------------------------
# LM Studio and Ollama both expose an OpenAI-compatible endpoint and need no
# key. If your model has no native tool calling, the runtime automatically
# falls back to the text protocol -- no config needed.
#
# LM Studio:  http://127.0.0.1:1234/v1
# Ollama:     http://127.0.0.1:11434/v1
#
# These are configured in ~/.wukong/config.toml under [models.local], not here.

# --- Runtime --------------------------------------------------------------
# Where state, logs, artifacts and the SQLite database live. Default ~/.wukong
# WUKONG_HOME=/Users/you/.wukong

# Default model alias from config.toml
# WUKONG_DEFAULT_MODEL=deepseek

# Override the workspace the agent is fenced into. Defaults to $PWD.
# WUKONG_WORKSPACE=/Users/you/project
